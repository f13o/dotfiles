// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    "font_size": 14.0,
    "font_family": ".ZedSans",
    "code_font_family": ".ZedMono",
  },
  "languages": {
    "Markdown": {
      "preferred_line_length": 100,
      "tab_size": 2,
    },
    "Helm": {
      "colorize_brackets": true,
      "tab_size": 2,
    },
    "YAML": {
      "ensure_final_newline_on_save": true,
      "remove_trailing_whitespace_on_save": true,
      "tab_size": 2,
    },
  },
  "icon_theme": "Zed (Default)",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "format_on_save": "on",
  "vim": {
    "toggle_relative_line_numbers": false,
  },
  "toolbar": {
    "breadcrumbs": true,
  },
  "minimap": {
    "show": "always",
  },
  "relative_line_numbers": "enabled",
  "project_panel": {
    "hide_hidden": false,
    "indent_size": 10.0,
    "entry_spacing": "comfortable",
    "default_width": 240.0,
    "dock": "left",
  },
  "proxy": "",
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "high",
    },
    "dock": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "prettier": {
    "allowed": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Andromeda Dark",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
  },
}
